# Copy to front/.env — used on local + Netlify (Site → Environment variables)
# Master map / URL bookmarks: ../env_example
# Only VITE_* vars are exposed to the browser. Never add SERVICE_ROLE here.

# --- API (Express on local or Render) ----------------------------------------
# Local:  http://localhost:3001/api
# Prod:   RENDER_API_BASE from ../env_example
VITE_API_BASE_URL=http://localhost:3001/api

# --- Supabase (same project as back; anon key only) --------------------------
# From Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Netlify / site URL (optional; useful for redirects & OAuth) -------------
# Local:  http://localhost:5173
# Prod:   NETLIFY_SITE_URL from ../env_example
VITE_SITE_URL=http://localhost:5173
# VITE_SUPABASE_AUTH_REDIRECT_URL=https://YOUR_SITE.netlify.app

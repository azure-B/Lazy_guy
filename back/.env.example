# Copy to back/.env — used on local + Render (Web Service → Environment)
# Master map / URL bookmarks: ../env_example

# --- Server ------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Browser origins allowed to call this API (comma-separated allowlist)
# Local:  http://localhost:5173
# Prod:   https://YOUR_SITE.netlify.app
# Never use * in production
CORS_ORIGIN=http://localhost:5173

# --- Supabase (same project as front) ----------------------------------------
# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional if models use anon + user JWT instead of service role:
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Render (set these in Render Dashboard; keep blank locally if unused) ----
# Public API URL of this service (for logs / callbacks)
# RENDER_EXTERNAL_URL=https://YOUR_SERVICE.onrender.com
# RENDER_API_BASE=https://YOUR_SERVICE.onrender.com/api
